# Copie para .env e ajuste. Nunca versione o .env.
DJANGO_SECRET_KEY=troque-esta-chave
DJANGO_DEBUG=1
# 0 desliga a exigência de 2FA (use apenas para testes locais)
EXIGIR_2FA=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Banco (vazio = SQLite local). Para PostgreSQL:
# DB_NAME=loja
# DB_USER=loja
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
# E-mail (SMTP é o canal principal)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=secretaria@exemplo.org
# WhatsApp via Evolution API (opcional, só certificados)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
SITE_URL=http://localhost:8000
